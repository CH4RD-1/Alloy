# Supabase project settings > API. Easy to swap these two by mistake since
# they're right next to each other on that page — Supabase's newer key
# format tags them so you can double check: the anon key starts with
# "sb_publishable_...", the service role key starts with "sb_secret_...".
# Swapping them doesn't fail loudly — every server-only write that's
# supposed to bypass RLS (Portal submissions, email/WhatsApp ticket intake)
# just silently runs as anon instead and gets rejected by ordinary RLS
# policies, which shows up as a "new row violates row-level security
# policy" error on an anonymous submission.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your deployed app's own URL, no trailing slash — used by lib/actions.ts's
# appBaseUrl() to build the accept-invite link sent in an invite email
# (createInvite). Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=

# Your app's own root domain, no protocol/path/trailing dot, e.g.
# alloyapp.com — turns on org-subdomain routing (middleware.ts): visiting
# <org-slug>.<this> serves that org's public Portal, same content as
# /portal/<org-slug> today. Leave unset to skip this entirely — the app
# works exactly as before, path-based /portal/<slug> URLs always work
# either way. Subdomains of "localhost" resolve in most browsers without
# any extra setup, so you can test this locally by setting it to just
# "localhost" (no port — middleware.ts strips the port from both sides
# before comparing) and visiting e.g. http://acme.localhost:3000.
NEXT_PUBLIC_ROOT_DOMAIN=

# Email channel adapter (Postmark) — see app/api/webhooks/email/route.ts
# and lib/actions.ts's sendChannelReply.
#   POSTMARK_INBOUND_SECRET   shared secret appended to the inbound webhook
#                             URL you give Postmark, e.g.
#                             https://yourapp.tld/api/webhooks/email?secret=...
#   POSTMARK_SERVER_TOKEN     Server settings > API Tokens — for sending
#                             outbound replies via Postmark's send API.
#   EMAIL_FROM_ADDRESS        the address outbound replies are sent From,
#                             e.g. support@yourapp.tld (must be a Postmark
#                             sender signature / verified domain).
#   EMAIL_INBOUND_DOMAIN      the domain your ticket addresses use, e.g.
#                             tickets.yourapp.tld (Postmark's inbound
#                             stream's MX domain) — new tickets go to
#                             support+org-<org-slug>@this domain; replies go
#                             to support+task-<task-id>@this domain (see
#                             lib/channel-verify.ts).
POSTMARK_INBOUND_SECRET=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=
EMAIL_INBOUND_DOMAIN=

# WhatsApp channel adapter (Twilio) — see app/api/webhooks/whatsapp/route.ts
# and lib/actions.ts's sendChannelReply. This adapter is single-tenant per
# deployment (one Twilio WhatsApp sender == one org) — see the route's own
# comment for why.
#   WHATSAPP_VERIFY_TOKEN     only needed if you use Meta's Cloud API
#                             directly instead of Twilio (the GET handshake).
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN   from your Twilio console —
#                             AUTH_TOKEN also verifies inbound webhook
#                             signatures (X-Twilio-Signature).
#   TWILIO_WHATSAPP_FROM      your Twilio WhatsApp sender number, E.164,
#                             no "whatsapp:" prefix (e.g. +14155238886 for
#                             the Twilio Sandbox while testing).
#   WHATSAPP_ORG_SLUG         which org (by orgs.slug) this deployment's
#                             single WhatsApp sender belongs to.
WHATSAPP_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_ORG_SLUG=

# Billing (Stripe) — see lib/billing.ts and app/api/webhooks/stripe/route.ts.
# First pass: one plan (STRIPE_PRICE_ID), no enforcement anywhere in the app
# yet — this wires up subscribing and keeping subscription_status in sync,
# nothing more. Leave unset to skip billing entirely; the Organization
# panel's Billing section just says it isn't configured.
#   STRIPE_SECRET_KEY     Developers > API keys in the Stripe Dashboard
#                          (test mode while you're trying this out).
#   STRIPE_WEBHOOK_SECRET the signing secret for this endpoint's webhook —
#                          from `stripe listen` while testing locally, or
#                          Developers > Webhooks once you add the endpoint
#                          for real (POST /api/webhooks/stripe).
#   STRIPE_PRICE_ID        the id of the one Price this deployment sells
#                          subscriptions to (Product catalog > a Price's
#                          id, starts with "price_").
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
